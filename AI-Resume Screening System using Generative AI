def highlight_keywords(resume_text, job_desc):
    # Define common stopwords to ignore
    stopwords = set([
        "and", "or", "the", "a", "an", "is", "are", "was", "were", 
        "in", "on", "at", "for", "to", "of", "with", "by", "as", "from"
    ])
    # Extract words from job description
    keywords = re.findall(r'\b\w+\b', job_desc.lower())
    # Filter out stopwords
    keywords = [kw for kw in keywords if kw not in stopwords]
    resume_html = resume_text
    for kw in set(keywords):
        if kw.strip():
            # Highlight keyword (case-insensitive)
            resume_html = re.sub(f"(?i)\\b({kw})\\b", r"<mark>\1</mark>", resume_html)
    return resume_html
