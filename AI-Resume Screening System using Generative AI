def analyze_soft_skills(resume_text):
    """
    Detect soft skills in a resume.
    Returns:
        found_skills: skills present in resume
        missing_skills: skills absent in resume
    """
    resume_lower = resume_text.lower()
    found_skills = [skill for skill in soft_skills if skill in resume_lower]
    missing_skills = [skill for skill in soft_skills if skill not in resume_lower]
    return found_skills, missing_skills


