def safe_gemini_call(prompt_parts, cache_key=None, mode="resume_analysis"):

    if "gemini_cache" not in st.session_state:
        st.session_state.gemini_cache = {}

    if cache_key and cache_key in st.session_state.gemini_cache:
        return st.session_state.gemini_cache[cache_key]

    try:
        model = genai.GenerativeModel("gemini-2.5-flash")
        # ✅ Combine all parts into a single string
        full_prompt = "\n".join([str(p) for p in prompt_parts])
        response = model.generate_content(full_prompt)
        text = response.text if hasattr(response, "text") else str(response)

        if cache_key:
            st.session_state.gemini_cache[cache_key] = text
        st.session_state.gemini_offline = False 
        return text


    except Exception as e:
        st.session_state.gemini_offline = True
         
        if mode == "resume_analysis":
            return fallback_resume_analysis()
        elif mode == "skills_improvement":
            return fallback_skills_improvement()
        elif mode == "percentage_match":
            return fallback_percentage_match()
        elif mode == "personalized_career":
             return fallback_resume_analysis()
        elif mode == "career_chat":
            return fallback_career_chat("Your question")  # can replace with real question
        else:
            return "⚠️ Gemini offline - response not available"
       


# ----------------- Gemini Response -----------------
def get_gemini_response(prompt, resume_text, job_description):
    cache_key = hashlib.sha256(
        f"{prompt}|{resume_text}|{job_description}".encode()
    ).hexdigest()

    return safe_gemini_call(
        [prompt, resume_text, job_description],
        cache_key=cache_key
    )
# ----------------- Centralized Gemini Call -----------------
