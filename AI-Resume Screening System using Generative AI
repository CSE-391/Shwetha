def detect_experience_level(resume_text):
    """
    Detects candidate experience level from resume text.
    Returns: Junior / Mid-Level / Senior
    """
    resume_text = resume_text.lower()
    
    # Search for keywords
    if re.search(r'\b(intern|entry[-\s]?level|junior)\b', resume_text):
        return "Junior Level"
    elif re.search(r'\b(mid[-\s]?level|associate)\b', resume_text):
        return "Mid Level"
    elif re.search(r'\b(senior|lead|manager|director)\b', resume_text):
        return "Senior Level"
    
    # Search for years of experience
    years_match = re.findall(r'(\d+)\+?\s?(?:years|yrs)\s?(?:of experience)?', resume_text)
    if years_match:
        years = max([int(y) for y in years_match])
        if years <= 2:
            return "Junior Level"
        elif 3 <= years <= 5:
            return "Mid Level"
        else:
            return "Senior Level"

    # Default fallback
    return "Not specified"
def extract_pdf_text(uploaded_file):
    """
    Extracts text from all pages of a PDF file.
    """
    uploaded_file.seek(0)
    all_text = ""
    with pdfplumber.open(uploaded_file) as pdf:
        for page in pdf.pages:
            if page.extract_text():
                all_text += page.extract_text() + "\n"
    return all_text
